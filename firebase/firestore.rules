rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function ownerDoc(ownerId) {
      return get(/databases/$(database)/documents/users/$(ownerId)).data;
    }

    function memberRole(ownerId) {
      return ownerDoc(ownerId).members[request.auth.uid];
    }

    function canRead(ownerId) {
      return isAuthenticated() && (
        request.auth.uid == ownerId ||
        memberRole(ownerId) in ['owner', 'editor', 'viewer']
      );
    }

    function canWrite(ownerId) {
      return isAuthenticated() && (
        request.auth.uid == ownerId ||
        memberRole(ownerId) in ['owner', 'editor']
      );
    }

    match /users/{userId} {
      // Members can read the owner's user doc (needed to resolve role / profile).
      allow read: if canRead(userId);
      // Writes to the user doc itself (settings, members map, bankConnections,
      // memberProfiles, pendingMembers) stay owner-only.
      allow write: if isAuthenticated() && request.auth.uid == userId;

      match /transactions/{transactionId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /categories/{categoryId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /rules/{ruleId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /bankConnections/{connectionId} {
        // Owner-only: these docs carry the Enable Banking sessionId and IBANs.
        // Members see sanitized connection status via the getBankStatus
        // callable (Admin SDK), never by reading these docs directly.
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /budgets/{budgetId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /icsStatements/{statementId} {
        allow read: if canRead(userId);
        allow create, update, delete: if false;
      }

      match /rawBankTransactions/{rawId} {
        allow read: if canRead(userId);
        // Reset is owner-only.
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if false;
      }

      match /goals/{goalId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /investments/{investmentId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /holdings/{holdingId} {
        allow read: if canRead(userId);
        // Bank-synced cash holdings are written server-side (Admin SDK), but
        // members with editor rights may create/update manual holdings.
        allow write: if canWrite(userId);
      }

      match /investmentTransactions/{txnId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }

      match /insights/{insightId} {
        allow read: if canRead(userId);
        allow update: if canWrite(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create, delete: if false;
      }

      match /advisorMemory/{docId} {
        allow read: if canRead(userId);
        allow create, update, delete: if false;
      }

      match /settings/{settingId} {
        allow read: if canRead(userId);
        allow write: if canWrite(userId);
      }
    }

    // Shared market data (index series, cached quotes). Written server-side via
    // the Admin SDK (which bypasses rules); readable by any signed-in user.
    match /marketData/{doc=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Reverse index of accounts a user has access to. Server-written only.
    match /memberships/{memberUid} {
      allow read: if isAuthenticated() && request.auth.uid == memberUid;
      allow write: if false;
    }

    // Server-only lookup table mapping invitee email -> ownerId.
    match /pendingInviteLookup/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
